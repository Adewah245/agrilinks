# Copy this file to backend/.env, fill in your settings, and run from backend/.
# Credentials are intentionally blank. Configure each provider before using it.

# Application
PORT=9000
APP_ENV=development
FRONTEND_DIR=../frontend
SESSION_TTL=24h
HTTP_REQUEST_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_REQUEST_BYTES=67108864
AUTH_REQUESTS_PER_MINUTE=20
AI_REQUESTS_PER_MINUTE=10

# Enable only behind a trusted proxy and list its networks as comma-separated CIDRs.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=

# Database: replace with your PostgreSQL connection string.
# For hosted PostgreSQL, use the provider's connection string and SSL settings.
DATABASE_URL=postgres://postgres:password@localhost:5432/agrilinks?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Diagnosis AI: API credentials and model IDs are separate settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Learning AI: Groq is primary; OpenRouter is the backup.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_REQUEST_TIMEOUT=30s
AI_MAX_TOKENS=1200

# Flutterwave payments: set both secrets to enable payments.
# SECRET_HASH must match the webhook secret hash in your Flutterwave dashboard.
# Configure the dashboard webhook URL as https://your-domain/webhooks/flutterwave.
# For deployment, replace the redirect below with your public HTTPS callback URL.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_PAYMENT_OPTIONS=card,banktransfer
PAYMENT_REDIRECT_URL=http://localhost:9000/payments/callback
PAYMENT_CURRENCY=NGN

# Marketplace and wallet
NEGOTIATION_MAX_ROUNDS=10
NEGOTIATION_WINDOW=24h
# Platform commission percentage, from 0 to 100, with up to two decimal places.
COMMISSION_PERCENT=0
# Comma-separated positive user IDs; leave blank until administrators are chosen.
WALLET_ADMIN_USER_IDS=
WALLET_STALE_DEPOSIT_HOURS=24

# OTP.dev is the default provider; only its API key is required before startup.
# The backend supplies sender "OTP Dev" and the Agro-Shield template UUID.
# Supported providers: disabled, otpdev (SMS), brevo (email).
# Registration phone confirmation requires otpdev.
OTPDEV_API_KEY=
# Optional overrides:
# SMS_PROVIDER=otpdev
# OTPDEV_BASE_URL=https://api.otp.dev/v1
# OTP_TTL=10m
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_INTERVAL=1m

# Brevo SMTP: fill in the login, key, and verified sender email before use.
# Set SMS_PROVIDER=brevo to deliver OTP codes by email.
BREVO_SMTP_HOST=smtp-relay.brevo.com:587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Agro-Shield

# Shared token used to authenticate the USSD gateway.
USSD_TOKEN=
