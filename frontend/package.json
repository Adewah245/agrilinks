{
  "name": "agrilinks-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "build:test": "vite build --config vite.test.config.js",
    "test": "npm run build && npm run build:test && node --test tests/*.test.mjs mobile/tests/*.test.mjs",
    "mobile:build": "vite build --config vite.mobile.config.js",
    "mobile:build:dev": "vite build --config vite.mobile.config.js --mode development",
    "mobile:sync": "npm run mobile:build && cap sync",
    "mobile:sync:dev": "npm run mobile:build:dev && cap sync",
    "mobile:android": "npm run mobile:build:dev && cap sync android && cap open android",
    "mobile:ios": "npm run mobile:build:dev && cap sync ios && cap open ios",
    "mobile:preview": "npm run mobile:build:dev && vite preview --config vite.mobile.config.js --mode development",
    "mobile:test": "node --test mobile/tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/browser": "8.0.5",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.0",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fortawesome/fontawesome-free": "6.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.10",
    "vite": "^7.3.7"
  }
}
